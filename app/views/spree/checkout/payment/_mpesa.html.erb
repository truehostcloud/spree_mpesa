<div class="mpesa-payment-fields" data-hook="mpesa_payment_fields">
  <div class="form-group">
    <%= label_tag "payment_source_#{payment_method.id}_phone", Spree.t(:phone) %>
    <%= text_field_tag "payment_source[#{payment_method.id}][phone]",
                       params.dig(:payment_source, payment_method.id.to_s, :phone),
                       class: 'form-control',
                       placeholder: '07XXXXXXXX',
                       required: true %>
    <small class="text-muted">
      You will receive an M-Pesa prompt on this number. Enter your PIN to pay.
    </small>
  </div>
</div>
